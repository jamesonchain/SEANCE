# Copy to .env.local. Never commit the copy.
NEXT_PUBLIC_TARI_WALLETD_URL=http://127.0.0.1:5100/json_rpc
NEXT_PUBLIC_TARI_NETWORK=esmeralda
NEXT_PUBLIC_TARI_INDEXER_URL=https://ootle-indexer-a.tari.com/

# Paste these real values after publishing/instantiating through the wallet UI.
NEXT_PUBLIC_SEANCE_TEMPLATE_ADDRESS=template_71f5c279c39d18ad7ca19b3f072a74e4fe61e83b188a2ffe771b9373923b0f8a
NEXT_PUBLIC_SEANCE_COMPONENT_ADDRESS=component_<hex>
# Native Esmeralda tTARI. The constructor stores this input; it does not mint
# a new resource, so it will not appear as a newly created resource in the receipt.
NEXT_PUBLIC_SEANCE_DEPOSIT_RESOURCE=resource_0101010101010101010101010101010101010101010101010101010101010101

# Account names used by the wallet UI/scripts. The browser signer uses the
# authenticated daemon's selected/default account; switch accounts in walletd
# when running the seller and bidder steps.
TARI_SELLER_ACCOUNT=seller
TARI_BIDDER1_ACCOUNT=bidder1
TARI_BIDDER2_ACCOUNT=bidder2

# Deployment-script-only values. Prefer the wallet UI so WebAuthn stays in the
# browser. If using publish-seance-template.mjs, export these in the shell;
# never put a token in .env.local or Git.
# TARI_AUTH_TOKEN=
# TARI_MAX_FEE=100000000
